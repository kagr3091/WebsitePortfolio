import { useState, useRef } from "react";
import { motion, useScroll, useTransform, useMotionValueEvent } from "framer-motion";
import { ArrowDownRight, Layout, Code2, Sparkles, Smartphone, Loader2, ArrowRight } from "lucide-react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";

/* ================= MAIN PAGE ================= */

export default function Home() {
  return (
    <main className="bg-background min-h-screen text-foreground">
      <div className="noise-overlay" />
      <Navbar />
      <Hero />
      <About />
      <Work />
      <Services />
      <Contact />
      <Footer />
    </main>
  );
}

/* ================= NAVBAR ================= */

function Navbar() {
  const [scrolled, setScrolled] = useState(false);
  const { scrollY } = useScroll();

  useMotionValueEvent(scrollY, "change", (latest) => {
    setScrolled(latest > 50);
  });

  return (
    <motion.header
      initial={{ y: -100 }}
      animate={{ y: 0 }}
      className={`fixed top-0 w-full z-40 ${
        scrolled ? "bg-background/80 backdrop-blur-md py-4" : "py-6"
      }`}
    >
      <div className="container mx-auto px-6 flex justify-between">
        <span className="text-white font-bold">STUDIO.</span>
        <a href="#contact" className="text-white">Let's Talk</a>
      </div>
    </motion.header>
  );
}

/* ================= HERO ================= */

function Hero() {
  const ref = useRef(null);
  const { scrollYProgress } = useScroll({ target: ref });

  const y = useTransform(scrollYProgress, [0, 1], ["0%", "30%"]);

  return (
    <section ref={ref} className="min-h-screen flex items-center justify-center text-center">
      <motion.div style={{ y }}>
        <h1 className="text-6xl text-white font-bold">
          Digital Craft
        </h1>
        <p className="text-muted-foreground mt-4">
          I build clean, modern websites.
        </p>
        <a href="#work" className="mt-6 inline-block bg-white text-black px-6 py-3">
          View Work <ArrowDownRight className="inline ml-2" />
        </a>
      </motion.div>
    </section>
  );
}

/* ================= ABOUT ================= */

function About() {
  return (
    <section id="about" className="py-20 text-center">
      <h2 className="text-primary uppercase">About</h2>
      <p className="text-muted-foreground mt-4 max-w-xl mx-auto">
        I design and build modern websites for businesses.
      </p>
    </section>
  );
}

/* ================= WORK ================= */

function Work() {
  const projects = ["Project 1", "Project 2", "Project 3"];

  return (
    <section id="work" className="py-20 text-center">
      <h2 className="text-white text-4xl mb-10">Projects</h2>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        {projects.map((p, i) => (
          <div key={i} className="bg-secondary p-6">
            {p}
          </div>
        ))}
      </div>
    </section>
  );
}

/* ================= SERVICES ================= */

function Services() {
  const services = [
    { icon: <Layout />, title: "Web Design" },
    { icon: <Code2 />, title: "Development" },
    { icon: <Sparkles />, title: "Animations" },
    { icon: <Smartphone />, title: "Mobile Ready" },
  ];

  return (
    <section id="services" className="py-20 text-center">
      <h2 className="text-white text-4xl mb-10">Services</h2>
      <div className="grid md:grid-cols-2 gap-6">
        {services.map((s, i) => (
          <div key={i} className="p-6 border">
            {s.icon}
            <h3 className="mt-2 text-white">{s.title}</h3>
          </div>
        ))}
      </div>
    </section>
  );
}

/* ================= CONTACT ================= */

const schema = z.object({
  name: z.string().min(2),
  email: z.string().email(),
  message: z.string().min(5),
});

function Contact() {
  const [loading, setLoading] = useState(false);

  const form = useForm({
    resolver: zodResolver(schema),
  });

  function onSubmit() {
    setLoading(true);
    setTimeout(() => setLoading(false), 1500);
  }

  return (
    <section id="contact" className="py-20 text-center">
      <h2 className="text-white text-4xl mb-6">Contact</h2>

      <form onSubmit={form.handleSubmit(onSubmit)} className="max-w-md mx-auto space-y-4">
        <input placeholder="Name" {...form.register("name")} className="w-full p-3" />
        <input placeholder="Email" {...form.register("email")} className="w-full p-3" />
        <textarea placeholder="Message" {...form.register("message")} className="w-full p-3" />

        <button className="bg-white text-black px-6 py-3 w-full">
          {loading ? <Loader2 className="animate-spin mx-auto" /> : "Send"}
        </button>
      </form>
    </section>
  );
}

/* ================= FOOTER ================= */

function Footer() {
  return (
    <footer className="py-10 text-center border-t">
      <h2 className="text-white text-3xl mb-4">Let's build something</h2>
      <a href="#contact" className="text-primary flex justify-center gap-2">
        Start <ArrowRight />
      </a>
      <p className="text-muted-foreground mt-6 text-sm">
        © {new Date().getFullYear()} Studio
      </p>
    </footer>
  );
}
