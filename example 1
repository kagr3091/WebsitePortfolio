  <script>
    // ── Year
    document.getElementById('year').textContent = new Date().getFullYear();

    // ── Navbar scroll effect
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });

    // ── Scroll reveal
    const revealEls = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
    revealEls.forEach(el => observer.observe(el));

    // ── Contact form validation & submission
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const formSuccess = document.getElementById('form-success');

    function validateField(id, groupId, test) {
      const group = document.getElementById(groupId);
      const valid = test(document.getElementById(id).value.trim());
      group.classList.toggle('has-error', !valid);
      return valid;
    }

    function runValidation() {
      const v1 = validateField('name',    'group-name',    v => v.length >= 2);
      const v2 = validateField('email',   'group-email',   v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v));
      const v3 = validateField('project', 'group-project', v => v.length >= 2);
      const v4 = validateField('message', 'group-message', v => v.length >= 10);
      return v1 && v2 && v3 && v4;
    }

    // Live validation on blur
    ['name','email','project','message'].forEach(id => {
      document.getElementById(id).addEventListener('blur', runValidation);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!runValidation()) return;

      submitBtn.classList.add('loading');
      submitBtn.disabled = true;

      // Simulated send — wire up your own endpoint here
      setTimeout(() => {
        form.style.display = 'none';
        formSuccess.classList.add('visible');
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;

        setTimeout(() => {
          formSuccess.classList.remove('visible');
          form.style.display = '';
          form.reset();
          document.querySelectorAll('.form-group').forEach(g => g.classList.remove('has-error'));
        }, 6000);
      }, 1500);
    });
  </script>
